# Django Environment Variables Configuration Template
# Copy this file to .env and adjust values for your local environment

# Secret key for cryptographic signing (use a random string in development, secure secret in production)
DJANGO_SECRET_KEY=django-insecure-week-03-repo-structure-stage-portfolio-0832b5b1-key

# Debug mode (True for local development, False for staging and production)
DJANGO_DEBUG=True

# Comma-separated list of host/domain names that this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1],testserver

# Database connection URL (defaults to SQLite if unspecified)
DATABASE_URL=sqlite:///db.sqlite3

# Default pagination page size for REST Framework
DEFAULT_PAGE_SIZE=10
